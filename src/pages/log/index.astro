---
import Layout from '../../layouts/Layout.astro';
import LogCard from '../../components/LogCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/site';

const posts = (await getCollection('log')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="Ownership Log — Jenny Camaro"
  description="Ownership, show, and maintenance notes from Jenny — a white third-gen Camaro with a stock 305 and 700R4."
>
  <section class="hero-gradient">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-sunset-400">Log</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-cream sm:text-5xl">Ownership &amp; build notes</h1>
      <p class="mt-5 max-w-2xl text-lg text-cream-muted">
        Cruises, garage Saturdays, and Norwood nostalgia — written in my voice, easy to extend with
        another Markdown file in <code class="rounded bg-dusk-800 px-1.5 py-0.5 text-sm text-sunset-200">src/content/log/</code>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid gap-5 md:grid-cols-2">
      {
        posts.map((post) => (
          <LogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            href={withBase(`log/${post.id}/`)}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>
</Layout>
