---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/site';
---

<Layout
  title="Jenny Camaro"
  description="Jenny — white third-gen Camaro."
  ogImage="assets/jenny-meet.jpg"
>
  <section class="bg-dusk-950 px-4 py-8 sm:px-6 sm:py-12">
    <figure class="mx-auto flex justify-center">
      <picture>
        <source
          media="(max-width: 767px)"
          srcset={withBase('assets/jenny-meet-mobile.jpg')}
          type="image/jpeg"
        />
        <img
          class="jenny-photo rounded-md"
          src={withBase('assets/jenny-meet.jpg')}
          alt="Jenny — white third-gen Camaro at a meet"
          width="900"
          height="675"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </figure>
  </section>
</Layout>
