---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/site';
---

<Layout
  title="Jenny Camaro"
  description="Jenny — white third-gen Camaro."
  ogImage="assets/jenny-meet.jpg"
>
  <section class="bg-dusk-950 px-3 py-6 sm:px-6 sm:py-10">
    <figure class="mx-auto max-w-3xl">
      <picture class="block w-full">
        <source
          media="(max-width: 767px)"
          srcset={withBase('assets/jenny-meet-mobile.jpg')}
          type="image/jpeg"
        />
        <img
          src={withBase('assets/jenny-meet.jpg')}
          alt="Jenny — white third-gen Camaro at a meet"
          class="mx-auto block h-auto w-full max-w-full rounded-md object-contain"
          width="1600"
          height="1200"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </figure>
  </section>
</Layout>
