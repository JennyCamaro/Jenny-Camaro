---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/site';
---

<Layout
  title="Jenny Camaro"
  description="Jenny — white third-gen Camaro."
  ogImage="assets/jenny-meet.jpg"
>
  <section class="min-h-[calc(100vh-4rem)] bg-dusk-950">
    <figure class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-6xl items-center px-2 py-4 sm:px-4 sm:py-6">
      <img
        src={withBase('assets/jenny-meet.jpg')}
        alt="Jenny — white third-gen Camaro at a meet"
        class="w-full rounded-lg object-contain shadow-[0_20px_60px_rgba(0,0,0,0.45)]"
        width="2400"
        height="1800"
        loading="eager"
      />
    </figure>
  </section>
</Layout>
